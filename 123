-- ============================================================
-- ME DEBUG SCANNER v1.2
-- Отладчик МЭ: сканирует сеть и выводит ВСЕ данные предметов.
--
-- Управление МЫШЬЮ: кнопки на 3-й строке, клик по строке списка,
-- колесо мыши для листания.
-- Управление КЛАВИАТУРОЙ: R G Enter Q Esc, стрелки, PgUp/PgDn.
--
-- v1.2: исправлен getItemDetail (драйвер требует поле 'id'),
--       добавлен блок «ТЕСТ СОВПАДЕНИЯ МАГАЗИНА» и типы ключевых полей.
-- ============================================================

local component = require("component")
local event = require("event")
local serialization = require("serialization")
local unicode = require("unicode")
local computer = require("computer")

local gpu = component.gpu
local w, h = gpu.getResolution()
local mw, mh = gpu.maxResolution()
if w < mw or h < mh then
  gpu.setResolution(mw, mh)
  w, h = gpu.getResolution()
end

-- ============================================================
-- АДРЕС ИНТЕРФЕЙСА (пусто = автопоиск первого доступного)
-- ============================================================
local ME_INTERFACE_ADDRESS = ""

local me = nil
if ME_INTERFACE_ADDRESS ~= "" then
  local okT, t = pcall(component.type, ME_INTERFACE_ADDRESS)
  if okT and t == "me_interface" then
    me = component.proxy(ME_INTERFACE_ADDRESS)
  end
else
  for addr in component.list("me_interface") do
    me = component.proxy(addr)
    break
  end
end

if not me then
  print("[ОШИБКА] Компонент me_interface не найден.")
  return
end

-- ===== Состояние =====
local running = true
local items = {}
local rawItems = {}
local mode = "group"
local view = "list"
local page = 1
local cursor = 1
local statusMsg = "Нажмите мышью [Скан] на 3-й строке или клавишу R"
local perPage = math.max(1, h - 6)
local detailLines = {}
local detailPage = 1
local detailTitle = ""
local uiButtons = {}

-- ===== Утилиты =====
local function wrap(str, width)
  local out = {}
  str = tostring(str or "")
  while unicode.len(str) > width do
    table.insert(out, unicode.sub(str, 1, width))
    str = unicode.sub(str, width + 1)
  end
  table.insert(out, str)
  return out
end

local function addLine(text)
  for _, wl in ipairs(wrap(text, w - 2)) do
    table.insert(detailLines, wl)
  end
end

local function stackLines(st)
  local lines = {}
  if type(st) ~= "table" then return { tostring(st) } end
  local keys = {}
  for k in pairs(st) do table.insert(keys, k) end
  table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
  for _, k in ipairs(keys) do
    local v = st[k]
    local valStr
    if type(v) == "table" then
      local ok, s = pcall(serialization.serialize, v)
      valStr = ok and s or "[таблица]"
    else
      valStr = tostring(v)
    end
    table.insert(lines, string.format("%s = %s", tostring(k), valStr))
  end
  return lines
end

local function getDisplayList()
  if mode == "raw" then return rawItems end
  return items
end

-- ===== Сканирование =====
local function scan()
  statusMsg = "Сканирование МЭ..."
  items = {}
  rawItems = {}
  local t0 = computer.uptime()
  local ok, list = pcall(function() return me.getItemsInNetwork() end)
  if not ok or type(list) ~= "table" then
    statusMsg = "Ошибка сканирования: " .. tostring(list)
    return
  end
  rawItems = list
  local groups = {}
  local order = {}
  for _, st in ipairs(list) do
    local name = st.name or st.label or st.id or "?"
    local dmg = tonumber(st.damage or st.dmg or st.meta or st.metadata or 0) or 0
    local size = tonumber(st.size or st.qty or st.count or 0) or 0
    local key = name .. ":" .. dmg
    if not groups[key] then
      groups[key] = { name = name, damage = dmg, total = 0, stacks = 0, sample = st }
      table.insert(order, key)
    end
    groups[key].total = groups[key].total + size
    groups[key].stacks = groups[key].stacks + 1
  end
  table.sort(order, function(a, b)
    if groups[a].name ~= groups[b].name then return groups[a].name < groups[b].name end
    return groups[a].damage < groups[b].damage
  end)
  items = {}
  for _, k in ipairs(order) do table.insert(items, groups[k]) end
  local dt = computer.uptime() - t0
  statusMsg = string.format("Найдено: %d уникальных, %d стеков (%.2f сек)", #items, #rawItems, dt)
  page = 1
  cursor = 1
  view = "list"
end

-- ===== Детальный просмотр =====
local function openDetail(idx)
  local list = getDisplayList()
  if idx < 1 or idx > #list then return end
  local st, title
  if mode == "group" then
    st = list[idx].sample
    title = list[idx].name .. "  (damage=" .. list[idx].damage .. ")"
  else
    st = list[idx]
    title = tostring(st.name or st.label or st.id or "?") ..
      "  (damage=" .. tostring(st.damage or st.dmg or st.meta or st.metadata or 0) .. ")"
  end
  detailTitle = title
  detailLines = {}

  addLine("=== ВСЕ ПОЛЯ ПРЕДМЕТА (из сети) ===")
  addLine("")
  addLine("ключевые поля:")
  addLine("  name   = " .. tostring(st.name) .. "  (" .. type(st.name) .. ")")
  addLine("  damage = " .. tostring(st.damage) .. "  (" .. type(st.damage) .. ")")
  addLine("  size   = " .. tostring(st.size) .. "  (" .. type(st.size) .. ")")
  addLine("  hasTag = " .. tostring(st.hasTag) .. "  (" .. type(st.hasTag) .. ")")
  addLine("  maxDamage = " .. tostring(st.maxDamage) .. "  | maxSize = " .. tostring(st.maxSize))
  addLine("")
  for _, l in ipairs(stackLines(st)) do addLine(l) end

  local name = st.name or st.label or st.id
  local dmg = tonumber(st.damage or st.dmg or st.meta or st.metadata or 0) or 0

  -- ==== getItemDetail(): драйвер GTNH требует поле 'id', а не 'name' ====
  if me.getItemDetail then
    addLine("")
    addLine("=== getItemDetail() ===")
    local ok2, det = pcall(function() return me.getItemDetail({ id = name, dmg = dmg }) end)
    if not ok2 or not det then
      local ok3, det3 = pcall(function() return me.getItemDetail({ id = name, damage = dmg }) end)
      if ok3 and det3 then ok2, det = true, det3 end
    end
    if ok2 and det then
      local okb, basic = pcall(function()
        if type(det.basic) == "function" then return det.basic() end
        return det.basic
      end)
      if okb and type(basic) == "table" then
        addLine("--- basic ---")
        for _, l in ipairs(stackLines(basic)) do addLine(l) end
      else
        for _, l in ipairs(stackLines(det)) do addLine(l) end
      end
    else
      addLine("getItemDetail не ответил: " .. tostring(det))
    end
  end

  -- ==== ТЕСТ СОВПАДЕНИЯ МАГАЗИНА ====
  addLine("")
  addLine("=== ТЕСТ СОВПАДЕНИЯ МАГАЗИНА ===")
  addLine("Ключ витрины: " .. tostring(name) .. ":" .. tostring(dmg))
  addLine("Фингерпринт покупки: { id = " .. tostring(name) .. ", dmg = " .. tostring(dmg) .. " }")

  local function sumFilter(label, filter)
    local okf, flist = pcall(function() return me.getItemsInNetwork(filter) end)
    if not okf then
      addLine(label .. " : ошибка драйвера: " .. tostring(flist):sub(1, 60))
      return
    end
    local total, withDmg = 0, 0
    if type(flist) == "table" then
      for _, it in ipairs(flist) do
        local sz = tonumber(it.size) or 0
        total = total + sz
        if (tonumber(it.damage) or 0) == dmg then withDmg = withDmg + sz end
      end
    end
    addLine(label .. " : всего " .. total .. ", из них damage=" .. tostring(dmg) .. ": " .. withDmg)
  end

  sumFilter("{id, dmg}    ", { id = name, dmg = dmg })
  sumFilter("{id, damage} ", { id = name, damage = dmg })
  sumFilter("{id}         ", { id = name })
  sumFilter("{name, dmg}  ", { name = name, dmg = dmg })

  if me.getItemDetail then
    local okd, d1 = pcall(function() return me.getItemDetail({ id = name, dmg = dmg }) end)
    if okd and d1 then
      local okb, b = pcall(function()
        if type(d1.basic) == "function" then return d1.basic() end
        return d1.basic
      end)
      if okb and type(b) == "table" then
        addLine("getItemDetail{id,dmg}.basic: qty=" .. tostring(b.qty or b.size or 0))
      else
        addLine("getItemDetail{id,dmg}: ответил, но basic недоступен")
      end
    else
      addLine("getItemDetail{id,dmg}: ошибка " .. tostring(d1):sub(1, 50))
    end
  end

  if st.hasTag == true then
    addLine("!! ПРЕДМЕТ ИМЕЕТ NBT-ТЕГ (hasTag=true)")
    addLine("!! Если покупка падает с «Не удалось выдать предмет» —")
    addLine("!! вероятно, exportItem не матчит стек с тегом по фингерпринту без тега.")
  end


  -- ==== ОРАКУЛ v1.4: какой фингерпринт драйвер узнаёт (безопасно, предметы не двигаются) ====
  addLine("")
  addLine("=== ОРАКУЛ: варианты фингерпринта ===")
  local function probe(label, fp)
    local okd, det = pcall(function() return me.getItemDetail(fp) end)
    local res
    if not okd then res = "ошибка"
    elseif not det then res = "nil"
    else res = "ОБЪЕКТ" end
    addLine(label .. " : " .. res)
  end

  -- P1: базовый (как сейчас шлёт магазин)
  probe("P1 {id,dmg}               ", { id = name, dmg = dmg })

  -- P2: round-trip — полная копия стека из сети
  local rt = {}
  for k, v in pairs(st) do rt[k] = v end
  probe("P2 round-trip все поля    ", rt)

  -- P3: round-trip без количества
  local rt2 = {}
  for k, v in pairs(st) do
    if k ~= "size" and k ~= "qty" and k ~= "count" then rt2[k] = v end
  end
  probe("P3 round-trip без size    ", rt2)

  -- P4: с зарядом из стека
  if st.charge ~= nil then
    probe("P4 {id,dmg,charge}        ", { id = name, dmg = dmg, charge = st.charge })
  end

  -- P5: флаг hasTag
  probe("P5 {id,dmg,hasTag=true}   ", { id = name, dmg = dmg, hasTag = true })

  -- P6/P7: кандидаты ключа nbt
  probe("P6 {id,dmg,nbt=''}        ", { id = name, dmg = dmg, nbt = "" })
  probe("P7 {id,dmg,nbt=empty-b64} ", { id = name, dmg = dmg, nbt = "CgAAAA==" })

    -- ==== ОРАКУЛ, РАУНД 2 ====
  local function probe2(label, fp)
    local okd, det = pcall(function() return me.getItemDetail(fp) end)
    local res
    if not okd then res = "ошибка: " .. tostring(det):sub(1, 40)
    elseif not det then res = "nil"
    else res = "ОБЪЕКТ" end
    addLine(label .. " : " .. res)
  end

  -- P8: id + все выставленные наружу поля тега (заряд, чары, tier...)
  local fp8 = { id = name, dmg = dmg }
  if st.charge ~= nil then fp8.charge = st.charge end
  if st.enchantments ~= nil then fp8.enchantments = st.enchantments end
  if st.tier ~= nil then fp8.tier = st.tier end
  if st.transferLimit ~= nil then fp8.transferLimit = st.transferLimit end
  if st.canProvideEnergy ~= nil then fp8.canProvideEnergy = st.canProvideEnergy end
  probe2("P8 {id,dmg,+поля тега} ", fp8)

  -- P9: полный round-trip НО с добавленным id (чинит причину ошибки P2/P3)
  local fp9 = {}
  for k, v in pairs(st) do fp9[k] = v end
  fp9.id = name
  probe2("P9 round-trip + id    ", fp9)

  -- P10: проверяем, не отравляет ли матчинг поле label
  probe2("P10 {id,dmg,label}    ", { id = name, dmg = dmg, label = st.label })


  detailPage = 1
  view = "detail"
end

-- ===== Навигация =====
local function moveCursor(delta)
  local list = getDisplayList()
  if #list == 0 then return end
  cursor = cursor + delta
  if cursor < 1 then cursor = 1 end
  if cursor > #list then cursor = #list end
  local totalPages = math.max(1, math.ceil(#list / perPage))
  page = math.floor((cursor - 1) / perPage) + 1
  if page < 1 then page = 1 end
  if page > totalPages then page = totalPages end
end

-- ===== Действия кнопок =====
local function doAction(a)
  if a == "scan" then scan()
  elseif a == "mode" then
    mode = (mode == "group") and "raw" or "group"
    page = 1; cursor = 1
    statusMsg = "Режим: " .. (mode == "group" and "ГРУППЫ" or "СЫРЫЕ СТЕКИ")
  elseif a == "detail" then openDetail(cursor)
  elseif a == "quit" then running = false
  elseif a == "back" then view = "list"
  elseif a == "pgup" then detailPage = detailPage - 1
  elseif a == "pgdn" then detailPage = detailPage + 1
  end
end

-- ===== Отрисовка списка =====
local function draw()
  gpu.setBackground(0x000000)
  gpu.setForeground(0xFFFFFF)
  gpu.fill(1, 1, w, h, " ")
  uiButtons = {}

  local list = getDisplayList()
  local totalPages = math.max(1, math.ceil(#list / perPage))
  if page > totalPages then page = totalPages end
  if page < 1 then page = 1 end

  gpu.setForeground(0x55FFFF)
  gpu.set(1, 1, "ME DEBUG SCANNER v1.2 | режим: " .. (mode == "group" and "ГРУППЫ" or "СЫРЫЕ СТЕКИ"))
  gpu.setForeground(0xFFFF55)
  gpu.set(w - 26, 1, string.format("стр %d/%d из %d", page, totalPages, #list))
  gpu.setForeground(0x888888)
  gpu.set(1, 2, "Мышь: кнопки ниже, клик по строке, колесо | Клавиши: R G Enter Q Esc, стрелки")

  local function bar(x, bw, label, action, color)
    gpu.setBackground(0x1a1a1a)
    gpu.setForeground(color)
    gpu.fill(x, 3, bw, 1, " ")
    gpu.set(x, 3, label)
    gpu.setBackground(0x000000)
    table.insert(uiButtons, { x = x, y = 3, w = bw, action = action })
  end
  bar(1, 10, "[Скан]", "scan", 0x55FF55)
  bar(12, 11, "[Режим]", "mode", 0xFFFF55)
  bar(24, 12, "[Детали]", "detail", 0x55FFFF)
  bar(37, 10, "[Выход]", "quit", 0xFF5555)

  local startIdx = (page - 1) * perPage + 1
  local y = 4
  for i = startIdx, math.min(startIdx + perPage - 1, #list) do
    local line
    if mode == "group" then
      local g = list[i]
      line = string.format("[%4d] %-42s dmg=%-5d кол-во=%-10d стеков=%d",
        i, unicode.sub(g.name, 1, 42), g.damage, g.total, g.stacks)
    else
      local st = list[i]
      local name = st.name or st.label or st.id or "?"
      local sdmg = tonumber(st.damage or st.dmg or st.meta or st.metadata or 0) or 0
      local size = tonumber(st.size or st.qty or st.count or 0) or 0
      line = string.format("[%4d] %-42s dmg=%-5d size=%d",
        i, unicode.sub(tostring(name), 1, 42), sdmg, size)
    end
    if i == cursor then
      gpu.setForeground(0x000000)
      gpu.setBackground(0x55FFFF)
    else
      gpu.setForeground(0xFFFFFF)
      gpu.setBackground(0x000000)
    end
    gpu.set(1, y, unicode.sub(line, 1, w))
    y = y + 1
  end
  gpu.setBackground(0x000000)

  gpu.setForeground(0x55FF55)
  gpu.set(1, h, unicode.sub(statusMsg, 1, w))
end

-- ===== Отрисовка деталей =====
local function drawDetail()
  gpu.setBackground(0x000000)
  gpu.setForeground(0xFFFFFF)
  gpu.fill(1, 1, w, h, " ")
  uiButtons = {}

  local totalPages = math.max(1, math.ceil(#detailLines / perPage))
  if detailPage > totalPages then detailPage = totalPages end
  if detailPage < 1 then detailPage = 1 end

  gpu.setForeground(0x55FFFF)
  gpu.set(1, 1, "ДЕТАЛИ: " .. unicode.sub(detailTitle, 1, w - 30))
  gpu.setForeground(0xFFFF55)
  gpu.set(w - 20, 1, string.format("стр %d/%d", detailPage, totalPages))
  gpu.setForeground(0x888888)
  gpu.set(1, 2, "Мышь: кнопки ниже, колесо | Клавиши: стрелки, PgUp/PgDn, Esc/Q/Enter — назад")

  local function bar(x, bw, label, action, color)
    gpu.setBackground(0x1a1a1a)
    gpu.setForeground(color)
    gpu.fill(x, 3, bw, 1, " ")
    gpu.set(x, 3, label)
    gpu.setBackground(0x000000)
    table.insert(uiButtons, { x = x, y = 3, w = bw, action = action })
  end
  bar(1, 10, "[Назад]", "back", 0xFF5555)
  bar(12, 10, "[Вверх]", "pgup", 0x55FFFF)
  bar(23, 10, "[Вниз]", "pgdn", 0x55FFFF)

  local startIdx = (detailPage - 1) * perPage + 1
  local y = 4
  gpu.setForeground(0xFFFFFF)
  for i = startIdx, math.min(startIdx + perPage - 1, #detailLines) do
    gpu.set(1, y, unicode.sub(detailLines[i], 1, w))
    y = y + 1
  end
end

-- ===== Главный цикл =====
while running do
  if view == "list" then draw() else drawDetail() end

  local ev = { event.pull() }
  local evType = ev[1]

  if evType == "key_down" then
    local char = ev[3] or 0
    local code = ev[4] or 0
    local lc = char
    if lc >= 65 and lc <= 90 then lc = lc + 32 end

    if view == "list" then
      if code == 200 then moveCursor(-1)
      elseif code == 208 then moveCursor(1)
      elseif code == 201 then moveCursor(-perPage)
      elseif code == 209 then moveCursor(perPage)
      elseif lc == 13 or code == 28 then doAction("detail")
      elseif lc == 114 or code == 19 then doAction("scan")
      elseif lc == 103 or code == 34 then doAction("mode")
      elseif lc == 113 or code == 16 then doAction("quit")
      elseif lc == 27 or code == 1 then doAction("quit")
      end
    else
      if code == 200 then detailPage = detailPage - 1
      elseif code == 208 then detailPage = detailPage + 1
      elseif code == 201 then detailPage = detailPage - perPage
      elseif code == 209 then detailPage = detailPage + perPage
      elseif lc == 27 or code == 1 or lc == 113 or code == 16 or lc == 13 or code == 28 then
        view = "list"
      end
    end

  elseif evType == "touch" then
    local tx, ty = ev[3], ev[4]
    local hit = nil
    for _, b in ipairs(uiButtons) do
      if ty == b.y and tx >= b.x and tx < b.x + b.w then
        hit = b.action
        break
      end
    end
    if hit then
      doAction(hit)
    elseif view == "list" and ty >= 4 and ty < 4 + perPage then
      local idx = (page - 1) * perPage + (ty - 3)
      local list = getDisplayList()
      if idx >= 1 and idx <= #list then
        if cursor == idx then
          openDetail(idx)
        else
          cursor = idx
        end
      end
    end

  elseif evType == "scroll" then
    local dir = -(ev[5] or 0)
    if view == "list" then
      moveCursor(dir * 3)
    else
      detailPage = detailPage - dir * 3
    end
  end
end

-- Очистка при выходе
gpu.setBackground(0x000000)
gpu.setForeground(0xFFFFFF)
gpu.fill(1, 1, w, h, " ")
print("ME Debug Scanner завершён.")
